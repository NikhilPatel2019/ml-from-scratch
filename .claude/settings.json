{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(progress:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python site/build.py)",
      "Bash(ruff check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(/site/index.html)"
    ]
  }
}
