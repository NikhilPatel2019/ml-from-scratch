# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf

*.cmd   text eol=crlf
*.bat   text eol=crlf

# Keep generated notebook output out of diffs.
*.ipynb text eol=lf linguist-documentation
